{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical AI Architecture Manifest",
  "type": "object",
  "required": [
    "magic",
    "architectureVersion",
    "schemaVersion",
    "components"
  ],
  "properties": {
    "magic": {
      "const": "PAI-PLATFORM"
    },
    "architectureVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}