{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uncertainty Study Request",
  "type": "object",
  "required": ["parameters", "samples", "seed", "metrics"],
  "additionalProperties": false,
  "properties": {
    "parameters": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "oneOf": [
      { "type": "object", "required": ["name", "distribution", "min", "max"], "properties": { "name": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}, "distribution":{"const":"uniform"}, "min":{"type":"number"}, "max":{"type":"number"} }, "additionalProperties": false },
      { "type": "object", "required": ["name", "distribution", "mean", "stddev", "min", "max"], "properties": { "name": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}, "distribution":{"const":"normal"}, "mean":{"type":"number"}, "stddev":{"type":"number","minimum":0}, "min":{"type":"number"}, "max":{"type":"number"} }, "additionalProperties": false }
    ] } },
    "samples": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "metrics": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type":"string", "pattern":"^[A-Za-z][A-Za-z0-9_.-]{0,63}$" } }
  }
}
