{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ayeai:compute:result:1",
  "$comment": "Copyright \u00a9 1993-2026 Abhishek Choudhary. All rights reserved. AyeAI\u00ae, AyeAM\u00ae and AyeCNSe\u00ae are registered trademarks. Licensed GPL-3.0-only.",
  "type": "object",
  "required": [
    "protocol",
    "jobId",
    "inputDigest",
    "outputDigest",
    "providerId",
    "providerVersion",
    "status",
    "evidenceState",
    "result"
  ],
  "properties": {
    "protocol": {
      "const": "ayeai.compute.job/v1"
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "outputDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "providerVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNAVAILABLE",
        "UNKNOWN",
        "INVALID"
      ]
    },
    "evidenceState": {
      "enum": [
        "PLANNED",
        "SIMULATED"
      ]
    },
    "result": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
